{
  "id": "com.glitchtip.cloudron",
  "title": "GlitchTip",
  "author": "Darkhorse",
  "packagerName": "Darkhorse",
  "packagerUrl": "https://github.com/paramedicspecialist",
  "packageUrl": "https://github.com/paramedicspecialist/glitchtip-cloudron",
  "tagline": "Error tracking for your Cloudron",
  "version": "6.2.6",
  "upstreamVersion": "6.2.6",
  "description": "file://DESCRIPTION.md",
  "changelog": "file://CHANGELOG",
  "postInstallMessage": "file://POSTINSTALL.md",
  "website": "https://glitchtip.com",
  "documentationUrl": "https://glitchtip.com/documentation",
  "forumUrl": "https://gitlab.com/glitchtip/glitchtip-backend/-/issues",
  "healthCheckPath": "/_health/",
  "httpPort": 8000,
  "memoryLimit": 1073741824,
  "minBoxVersion": "10.0.0",
  "manifestVersion": 2,
  "optionalSso": true,
  "icon": "file://logo.png",
  "iconUrl": "https://raw.githubusercontent.com/paramedicspecialist/glitchtip-cloudron/main/logo.png",
  "mediaLinks": [
    "https://raw.githubusercontent.com/paramedicspecialist/glitchtip-cloudron/main/screenshot.png"
  ],
  "tags": [
    "monitoring",
    "errors",
    "sentry"
  ],
  "addons": {
    "localstorage": {},
    "postgresql": {},
    "redis": {},
    "sendmail": {},
    "oidc": {
      "loginRedirectUri": "/accounts/oidc/cloudron/login/callback/",
      "logoutRedirectUri": "/",
      "tokenSignatureAlgorithm": "RS256"
    }
  },
  "checklist": {
    "first-admin-sso": {
      "sso": true,
      "message": "Sign in with Cloudron. That first account is the administrator. Create an organization in the app."
    },
    "first-admin-local": {
      "sso": false,
      "message": "Create the first account on the sign-in page. That person creates the organization. Public signup closes after that account."
    }
  }
}
